# Sadaat Travels Management System - Environment Variables
# Copy this file to .env and fill in actual values.

# ============================================================================
# CLIENT-SIDE VARIABLES (safe to expose in browser)
# ============================================================================

# Supabase Configuration (Client-side)
VITE_SUPABASE_URL=your-supabase-project-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Application
VITE_APP_NAME=Sadaat Travels
VITE_APP_ENV=development

# ============================================================================
# SERVER-SIDE VARIABLES (NEVER expose to browser - for scripts/admin only)
# ============================================================================

# WARNING: These variables are for server-side scripts only!
# They must NEVER be prefixed with VITE_ as that exposes them to the browser.
# Keep these secret and secure. Never commit .env to Git.

# Supabase Service Role Key (Admin access - KEEP SECRET)
# Get this from: Supabase Dashboard → Settings → API → Service Role Key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Supabase URL (same as VITE_SUPABASE_URL)
SUPABASE_URL=your-supabase-project-url

# For password reset script only (delete after use):
TARGET_USER_EMAIL=user-email-to-reset
NEW_PASSWORD=new-password-to-set
