```gitignore
# Dependencies
node_modules/

# Build outputs
dist/
build/
target/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.py~
*.py.class
.Python
env/
venv/
.venv/
.env
.env.local
.env.*
pyproject.toml
poetry.lock

# Compiled and binary files
*.o
*.obj
*.so
*.a
*.lib
*.dll
*.dylib
*.exe
*.out

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Temporary files
*.tmp
*.temp
*~
.DS_Store
Thumbs.db

# Coverage
coverage/
htmlcov/
.coverage

# IDE
.vscode/
.idea/
*.swp
*.swo

# Cache
.cache/
.mypy_cache/
.pytest_cache/
.gradle/
.npm/
.yarn/

# Distribution
*.tar.gz
*.zip
*.rar
*.7z
*.gz
*.bz2
*.xz
*.zst
*.lz4
*.lzh
*.cab
*.arj
*.rpm
*.deb
*.Z
*.lz
*.lzo

# Images (if accidentally added)
*.png
*.jpg
*.jpeg
*.gif
*.bmp
*.webp
*.svg
*.ico
```