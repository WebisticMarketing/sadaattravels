```gitignore
# Dependencies
node_modules/

# Build outputs
dist/
build/
*.js.map

# Environment variables
.env
.env.local
*.env.*

# Editors
.vscode/
.idea/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.venv/

# Logs
*.log

# OS generated files
.DS_Store
Thumbs.db

# Coverage reports
coverage/
htmlcov/
.coverage

# Temporary files
*.tmp
*.temp
*.bak

# MyPy cache
.mypy_cache/
# Pytest cache
.pytest_cache/

# Git
.git/
!.gitignore

# TypeScript/JavaScript specific
*.tsbuildinfo
.next/
nuxt/dist/

# Compressed files
*.zip
*.gz
*.tar
*.tgz
*.bz2
*.xz
*.7z
*.rar
*.zst
*.lz4
*.lzh
*.cab
*.arj
*.rpm
*.deb
*.Z
*.lz
*.lzo
*.tar.gz
*.tar.bz2
*.tar.xz
*.tar.zst

# Lock files
package-lock.json
yarn.lock
Pipfile.lock
poetry.lock

# IDE specific
.vs/
*.swp
*.swo

# Distribution / packaging
*.egg
*.egg-info/
dist/
dists/
*.tar.gz
*.whl
```