node_modules/

# Build artifacts
dist/
build/
*.js
*.jsx
*.ts
*.tsx
*.css
*.scss
*.sass
*.less

# Environment variables
.env
.env.local
*.env.*

# IDE files
.vscode/
.idea/
*.swp
*.swo
*.tmp

# Logs
*.log

# Coverage
coverage/
htmlcov/
.coverage

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so
*.egg-info/
.eggs/
.venv/
venv/
pip-log.txt
pip-delete-this-directory.txt
.tox/
.coverage
.nox/
.mypy_cache/
.pytest_cache/
.hypothesis/

# Node.js
npm-debug.log*
yarn-debug.log*
yarn-error.log*
node_modules/
dist/
build/
coverage/
*.min.js
*.min.css

# TypeScript
*.tsbuildinfo
*.js.map
*.jsx.map
*.ts.map
*.tsx.map

# React/Next.js
.next/
out/
public/static/

# General
.DS_Store
Thumbs.db
```