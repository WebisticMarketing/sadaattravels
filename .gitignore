# TypeScript/JavaScript
*.tsbuildinfo
*.js.map
*.jsx.map
*.ts.map

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment variables
.env
.env.local
.env.*
!.env.example

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
Thumbs.db

# Coverage
coverage/
.nyc_output/
istanbul/
.jest/

# Temporary files
*.tmp
*.temp
.DS_Store?
```
